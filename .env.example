# ---------------------------------------------------------------------------
# Public env vars (inlined into the client bundle at build time)
# ---------------------------------------------------------------------------

# Formspree form ID used by the contact page. Sign up free at
# https://formspree.io using hik8hik@gmail.com, create a form, and paste the
# ID (the bit after /f/ in the endpoint URL).
#
# Leave this blank to fall back to a mailto: link on the contact form.
NEXT_PUBLIC_FORMSPREE_ID=

# Only needed for the static export on GitHub Pages. Do not set locally.
# NEXT_PUBLIC_OUTPUT=export
